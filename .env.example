# DeepSeek API Key
DEEPSEEK_API_KEY=sk-你的API密钥

# DeepSeek Chat Completions endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Vision model
DEEPSEEK_MODEL=deepseek-flash

# Qwen review model (text-only consistency review of Flash JSON)
QWEN_API_KEY=sk-你的通义千问API密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_REVIEW_MODEL=qwen3.8-flash
ENABLE_STRONG_REVIEW=true
ENABLE_QWEN_VISION_REVIEW=true
QWEN_VISION_MODEL=qwen3.8-flash

# GLM vision peer
ENABLE_THIRD_VISION_REVIEW=true
THIRD_VISION_API_KEY=sk-你的第三视觉模型API密钥
THIRD_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
THIRD_VISION_MODEL=glm-5.3-flash

# Kimi vision peer
ENABLE_KIMI_VISION=true
KIMI_API_KEY=sk-你的KimiAPI密钥
KIMI_BASE_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_VISION_MODEL=kimi-k2.6

# Doubao vision peer (DOUBAO_VISION_MODEL is usually a Volcengine Ark
# endpoint ID such as ep-xxxxxxxx-xxxxx)
ENABLE_DOUBAO_VISION=true
DOUBAO_API_KEY=你的火山方舟API密钥
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_VISION_MODEL=ep-你的豆包视觉接入点ID

# Hard request timeout in seconds. Teacher requires finishing within 8 seconds.
REQUEST_TIMEOUT_SECONDS=8
PRIMARY_TIMEOUT_SECONDS=4.2
REVIEW_TIMEOUT_SECONDS=3.2
QWEN_VISION_TIMEOUT_SECONDS=7.2
THIRD_VISION_TIMEOUT_SECONDS=7.2
KIMI_VISION_TIMEOUT_SECONDS=7.2
DOUBAO_VISION_TIMEOUT_SECONDS=7.2

# Use low detail and compressed image for speed.
IMAGE_DETAIL=low
MAX_IMAGE_EDGE=768
JPEG_QUALITY=70
QWEN_MAX_IMAGE_EDGE=448
QWEN_JPEG_QUALITY=50
THIRD_MAX_IMAGE_EDGE=256
THIRD_JPEG_QUALITY=35
KIMI_MAX_IMAGE_EDGE=384
KIMI_JPEG_QUALITY=45
DOUBAO_MAX_IMAGE_EDGE=256
DOUBAO_JPEG_QUALITY=38

# Keep output short for speed.
MAX_TOKENS=1100
REVIEW_MAX_TOKENS=350
QWEN_VISION_MAX_TOKENS=350
THIRD_VISION_MAX_TOKENS=700
KIMI_VISION_MAX_TOKENS=320
DOUBAO_VISION_MAX_TOKENS=448
TEMPERATURE=0

# Thinking control: none=off, low=minimum, high/max=more reasoning.
REASONING_EFFORT=none

# HTTP API settings for a video-processing client.
# Keep 127.0.0.1 for local use. For trusted LAN use, set API_HOST=0.0.0.0
# and configure a strong API_ACCESS_TOKEN before exposing the service.
API_HOST=127.0.0.1
API_PORT=8000
# Required before exposing the API through a public tunnel.
API_ACCESS_TOKEN=change-this-to-a-long-random-token
API_MAX_UPLOAD_BYTES=12582912
API_PROCESS_TIMEOUT_SECONDS=10
API_MAX_CONCURRENT_REQUESTS=2

# Remote access helper.
# quick is for temporary testing and creates a random trycloudflare.com URL.
# named is for a Cloudflare dashboard tunnel with a saved tunnel token.
CLOUDFLARE_TUNNEL_MODE=quick
CLOUDFLARE_TUNNEL_TOKEN=
