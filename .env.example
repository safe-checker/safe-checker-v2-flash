# DeepSeek API Key
DEEPSEEK_API_KEY=sk-你的API密钥

# DeepSeek Chat Completions endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# Vision model
DEEPSEEK_MODEL=deepseek-flash

# Total request budget. One vision call is used; provider/network latency can
# still prevent a hard end-to-end guarantee.
REQUEST_TIMEOUT_SECONDS=8
# 瞬时网络故障（DNS、连接被拒）的重试：共享同一预算，预算耗尽不重试
MODEL_MAX_ATTEMPTS=3
MODEL_RETRY_MIN_BUDGET=1.0
MODEL_CONNECT_TIMEOUT=2.0
DEEPSEEK_VISION_TIMEOUT_SECONDS=7.4

# Use low detail and compressed image for speed.
IMAGE_DETAIL=low
MAX_IMAGE_EDGE=768
JPEG_QUALITY=70

# Optional Monkey-inspired input experiment. off=full image only;
# auto=full image plus one edge-texture crop (may select background).
# Or use x1,y1,x2,y2 on the EXIF-oriented original-image 0..1000 grid.
DETAIL_CROP=off
# 紧凑短键输出：显著降低模型输出长度，是八秒内完成率达标的关键
# full = 展开字段名（旧版行为），compact = 短键（默认）
OUTPUT_MODE=compact
DETAIL_CROP_MAX_EDGE=768
# 局部图独立 detail：全图 low 保全局、局部 high 保细节，留空则与全图一致
# DETAIL_CROP_IMAGE_DETAIL=high

# Person inventory, risk fields, regulation audit, and bounding boxes need a
# larger output cap. The model may stop earlier; this is not a forced length.
SINGLE_MODEL_MAX_TOKENS=2200
TEMPERATURE=0

# Thinking control: none=off, low=minimum, high/max=more reasoning.
REASONING_EFFORT=none

# Inspection checklist selection.
# AUTO (no --scene given) only:
#   subject = 主体清单，62 个可定位主体一行一条（默认，实测命中率最高）
#   scene   = 旧做法，逐场景给 3 条维度名称
#   family  = 场景家族合并清单，每个家族给核心维度
CHECKLIST_AUTO_MODE=subject
# 清单行是否加 [主体名] 前缀。默认 0：94 张配对实测开 81.7%、关 84.0%，方向为负。
CHECKLIST_SUBJECT_ANCHOR=0
# 最多输出几条风险。默认 3。调大到 5 实测不改变模型行为（它自己就只报 2~3 条）。
MAX_RISK_ITEMS=3

# HTTP API settings for a video-processing client.
# Keep 127.0.0.1 for local use. For trusted LAN use, set API_HOST=0.0.0.0
# and configure a strong API_ACCESS_TOKEN before exposing the service.
API_HOST=127.0.0.1
API_PORT=8002
# Required before exposing the API through a public tunnel.
API_ACCESS_TOKEN=change-this-to-a-long-random-token
API_MAX_UPLOAD_BYTES=12582912
# 进程硬杀上限，应比 REQUEST_TIMEOUT_SECONDS 宽松，才能拿到结构化超时错误
API_PROCESS_TIMEOUT_SECONDS=9.5
API_MAX_CONCURRENT_REQUESTS=2

# Remote access helper.
# quick is for temporary testing and creates a random trycloudflare.com URL.
# named is for a Cloudflare dashboard tunnel with a saved tunnel token.
CLOUDFLARE_TUNNEL_MODE=quick
CLOUDFLARE_TUNNEL_TOKEN=
